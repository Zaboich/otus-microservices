{
  "info": {
    "name": "OTUS lesson 12 - minimal-http",
    "description": "Проверка эндпоинтов сервиса minimal-http через Ingress arch.homework.\nЗапуск: newman run otus-lesson12.postman_collection.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://arch.homework"
    },
    {
      "key": "studentName",
      "value": "test"
    }
  ],
  "item": [
    {
      "name": "GET /health -> 200 {\"status\": \"OK\"}",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Content-Type is application/json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('Body is {\"status\": \"OK\"}', function () {",
              "    pm.expect(pm.response.json()).to.eql({\"status\": \"OK\"});",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /otusapp/{{studentName}}/health -> {\"status\": \"OK\"}",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/otusapp/{{studentName}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Content-Type is application/json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('Body is {\"status\": \"OK\"}', function () {",
              "    pm.expect(pm.response.json()).to.eql({\"status\": \"OK\"});",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    },
    {
      "name": "GET /test -> 404 {\"status\": \"Not Found\"}",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/test"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test('Content-Type is application/json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('Body is {\"status\": \"Not Found\"}', function () {",
              "    pm.expect(pm.response.json()).to.eql({\"status\": \"Not Found\"});",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /otusapp/{{studentName}}/test -> 404 {\"status\": \"Not Found\"}",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/otusapp/{{studentName}}/test"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test('Content-Type is application/json', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "pm.test('Body is {\"status\": \"Not Found\"}', function () {",
              "    pm.expect(pm.response.json()).to.eql({\"status\": \"Not Found\"});",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "followRedirects": false
      }
    }
  ]
}
